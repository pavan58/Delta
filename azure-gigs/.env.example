# ---- Azure Gigs environment variables (copy to .env; never commit real values) ----

# PostgreSQL connection string (Prisma).
DATABASE_URL="postgresql://azuregigs:azuregigs@localhost:5432/azuregigs?schema=public"
# Separate database used by the integration and E2E tests (they create data freely).
TEST_DATABASE_URL="postgresql://azuregigs:azuregigs@localhost:5432/azuregigs_test?schema=public"

# Public base URL of the app (used for OAuth redirects and absolute links).
APP_URL="http://localhost:3000"

# 32 random bytes, base64. Encrypts Azure OAuth tokens and simulated Key Vault secrets at rest.
#   openssl rand -base64 32
ENCRYPTION_KEY=""

# Optional: Redis for shared rate limiting / background jobs (see docs/SECURITY.md).
REDIS_URL=""

# Optional: bootstrap an administrator on `npm run db:seed`.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Optional: Real Azure Mode (Microsoft Entra app registration, see docs/REAL_AZURE.md).
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT="organizations"
