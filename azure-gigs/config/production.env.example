# Production: values come from the hosting platform's secret store (Vercel env vars / Container Apps secrets backed by Key Vault).
NODE_ENV=production
APP_URL=https://azuregigs.example.com
DATABASE_URL=<managed postgres production connection string, sslmode=require, connection_limit tuned>
ENCRYPTION_KEY=<production key - rotate per docs/SECURITY.md>
REDIS_URL=<required when running more than one instance>
AZURE_AD_CLIENT_ID=<production app registration>
AZURE_AD_CLIENT_SECRET=<secret store reference>
AZURE_AD_TENANT=organizations
