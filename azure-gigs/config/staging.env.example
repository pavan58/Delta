# Staging: production build, separate database, Real Azure Mode pointed at a sandbox tenant/app registration.
NODE_ENV=production
APP_URL=https://staging.azuregigs.example.com
DATABASE_URL=<managed postgres staging connection string, sslmode=require>
ENCRYPTION_KEY=<staging-only key from your secret store>
REDIS_URL=<optional>
AZURE_AD_CLIENT_ID=<staging app registration>
AZURE_AD_CLIENT_SECRET=<from Key Vault / platform secret store>
AZURE_AD_TENANT=organizations
