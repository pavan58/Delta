# ─────────────────────────────────────────────────────────────
# SpeakUp AI — environment variables
# Everything is OPTIONAL. With no variables set, the app runs in
# Free Mode + guest mode (all learning features work).
# Copy to .env.local for local development. Never commit real keys.
# ─────────────────────────────────────────────────────────────

# Public URL of the site (used in share links when rendering on the server)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase (accounts, cloud sync, leaderboard, admin) ──
# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses RLS — used only after server-side checks (admin, AI logs, account deletion).
SUPABASE_SERVICE_ROLE_KEY=
# Set to "true" after enabling the Google provider in Supabase Auth
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# ── Optional AI provider (server side only) ──
# AI_PROVIDER: none | anthropic | openai | groq | openrouter | openai-compatible | gemini | ollama
AI_PROVIDER=none

# Anthropic (Claude). Default model is the low-cost claude-haiku-5-5.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# OpenAI-compatible endpoints (OpenAI, Groq, OpenRouter, any /v1/chat/completions)
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Local development with Ollama (https://ollama.com) — free, runs on your machine
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ── Cost controls (defaults; admins can change them in /admin when Supabase is configured) ──
AI_DAILY_LIMIT_GUEST=10
AI_DAILY_LIMIT_USER=30
AI_GLOBAL_DAILY_LIMIT=2000
