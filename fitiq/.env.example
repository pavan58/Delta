# ---------------------------------------------------------------
# FITIQ environment. Leave blank to run in DEMO MODE (demo data,
# in-memory analytics, rule-based AI, local-only user data).
# ---------------------------------------------------------------

# PostgreSQL (Prisma). Required for persistent users/wardrobe/price history.
DATABASE_URL=

# Provider-agnostic AI layer. AI_PROVIDER = "rules" (default) | "anthropic" | "openai-compatible"
AI_PROVIDER=rules
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# Licensed product / affiliate feeds (see src/lib/providers)
PRODUCT_PROVIDER_KEY=
PRODUCT_FEED_URL=
AFFILIATE_ID=

# Object storage for wardrobe images (S3-compatible endpoint)
STORAGE_URL=

# Optional weather provider (OpenWeatherMap-compatible). No key => no weather claims.
WEATHER_API_KEY=

# 32-byte base64 key for field-level encryption of body measurements
ENCRYPTION_KEY=

# Protects /admin and /api/admin/* when set (required in production)
ADMIN_TOKEN=
